# carp-watchdog SITE-SPECIFIC / PRIVATE config — TEMPLATE.
#
# Copy to /etc/carp-watchdog/.env on the watchdog host and fill in real values:
#     install -m 600 .env.example /etc/carp-watchdog/.env   # then edit
# The real .env is gitignored and must be readable by the service user (chmod 600).
# Values below are RFC 5737 documentation addresses — replace them.

# Gateway VIP (CARP vhid) — pinged only for alert context
GATEWAY_VIP=192.0.2.1

# Primary firewall (CARP MASTER) — graceful-demotion target (Lever 1)
PRIMARY=192.0.2.2
PRIMARY_PORT=22
PRIMARY_USER=admin

# Backup firewall — pre-fire guard target
BACKUP=192.0.2.3
BACKUP_PORT=22
BACKUP_USER=admin

# Hypervisor host running the primary firewall VM — qm stop target (Lever 2)
HOST=192.0.2.6
HOST_PORT=22
HOST_USER=root
VMID=100

# Self-hosted ntfy base URL (local publish works even with the WAN down)
NTFY=http://192.0.2.5:2586

# Deep-links used in alert "Click" actions
WIKI_URL=https://wiki.example/carp-watchdog
BACKUP_UI=https://192.0.2.3
