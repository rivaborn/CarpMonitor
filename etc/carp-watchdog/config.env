# carp-watchdog NON-SENSITIVE tunables — /etc/carp-watchdog/config.env
#
# KEY=VALUE only (no `export`, no spaces around `=`). Comments must be on their
# own line (a `#` after a value is parsed as part of the value by systemd; the
# daemon strips a trailing " #..." defensively, but keep them on their own line).
#
# Site-specific / private values (IPs, hosts, ports, users, VMID, URLs) do NOT
# live here — they go in /etc/carp-watchdog/.env (gitignored). See .env.example.
# Precedence: built-in defaults < config.env < .env < real environment.

# --- timing ---
# POLL_INTERVAL: seconds between end-to-end polls
POLL_INTERVAL=30
# CONFIRM_FAILS: consecutive fails -> SUSPECT (+ "armed" alert) ~60s
CONFIRM_FAILS=2
# ARM_SECONDS: continuous-fail seconds in SUSPECT -> auto-fire (10 min)
ARM_SECONDS=600
# POST_FIRE_WAIT: after a lever, poll egress this long for recovery
POST_FIRE_WAIT=60
# REALERT_SECONDS: while latched (FIRED/HELD), repeat the ntfy reminder this
# often; 0 = never (6 h)
REALERT_SECONDS=21600

# --- detection ---
# CANARIES: public ICMP targets; healthy if ANY answers
CANARIES=1.1.1.1,8.8.8.8,9.9.9.9

# --- failover tunable ---
# DEMOTION: CARP demotion delta applied to the primary (Lever 1)
DEMOTION=240

# --- alerting topic (the ntfy base URL is private -> .env) ---
NTFY_TOPIC=carp-watchdog

# --- ssh / paths ---
SSH_KEY=/etc/carp-watchdog/id_ed25519
SSH_KNOWN_HOSTS=/etc/carp-watchdog/known_hosts
STATE_FILE=/var/lib/carp-watchdog/state.json
SSH_CONNECT_TIMEOUT=10
PING_COUNT=2
PING_TIMEOUT=2
