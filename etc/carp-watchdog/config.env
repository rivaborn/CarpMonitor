# carp-watchdog NON-SENSITIVE tunables — /etc/carp-watchdog/config.env
#
# KEY=VALUE only (no `export`, no spaces around `=`): parsed by the daemon and
# (optionally) by systemd EnvironmentFile.
#
# Site-specific / private values (IPs, hosts, ports, users, VMID, URLs) do NOT
# live here — they go in /etc/carp-watchdog/.env (gitignored). See .env.example.
# Precedence: built-in defaults < config.env < .env < real environment.

# --- timing ---------------------------------------------------------------
POLL_INTERVAL=30          # seconds between end-to-end polls
CONFIRM_FAILS=2           # consecutive fails -> SUSPECT (+ "armed" alert) ~60s
ARM_SECONDS=600           # continuous-fail seconds in SUSPECT -> auto-fire (10 min)
POST_FIRE_WAIT=60         # after a lever, poll egress this long for recovery

# --- detection ------------------------------------------------------------
CANARIES=1.1.1.1,8.8.8.8,9.9.9.9   # public ICMP targets; healthy if ANY answers

# --- failover tunable -----------------------------------------------------
DEMOTION=240              # CARP demotion delta applied to the primary (Lever 1)

# --- alerting topic (the ntfy base URL is private -> .env) -----------------
NTFY_TOPIC=carp-watchdog

# --- ssh / paths ----------------------------------------------------------
SSH_KEY=/etc/carp-watchdog/id_ed25519
SSH_KNOWN_HOSTS=/etc/carp-watchdog/known_hosts
STATE_FILE=/var/lib/carp-watchdog/state.json
SSH_CONNECT_TIMEOUT=10
PING_COUNT=2
PING_TIMEOUT=2
