[Unit]
Description=CARP wedge-watchdog (forces a pfSense CARP failover on a soft-wedge)
Documentation=https://github.com/rivaborn/CarpMonitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/carp-watchdog/watchdog.py
# The daemon reads /etc/carp-watchdog/config.env and .env itself (so it works
# when run by hand too); no EnvironmentFile needed.
Restart=always
RestartSec=10

# Dedicated unprivileged user. StateDirectory creates/owns /var/lib/carp-watchdog.
User=carp-watchdog
Group=carp-watchdog
StateDirectory=carp-watchdog
StateDirectoryMode=0750

# Hardening (the daemon only needs: outbound ICMP/SSH, read /etc/carp-watchdog,
# write its StateDirectory).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/carp-watchdog
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
