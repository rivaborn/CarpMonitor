# Line endings: LF in git and on disk on every machine; cmd.exe files CRLF (eol_normalize.py)
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# These files deploy to Linux (.5) and FreeBSD (pfSense) — always store and
# check out with LF so shebangs and shell scripts are not broken by CRLF.
*.py            text eol=lf
*.service       text eol=lf
*.env           text eol=lf
carp-watchdog-reset text eol=lf
